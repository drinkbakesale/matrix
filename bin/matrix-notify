#!/usr/bin/env bash
# Called by Claude Code hooks — sends in-app toast + web push notification
PROJECT=$(basename "$PWD")
MSG="${1:-Claude needs input in $PROJECT}"

SESSION=""
TMUX_SESSION=""

# Priority 1: tmux @matrix_project variable (set by matrix-project-tag.js hook)
if [ -n "$TMUX_PANE" ]; then
  TMUX_SESSION=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)
  SESSION=$(tmux show-option -t "$TMUX_SESSION" -v @matrix_project 2>/dev/null || true)
fi

# Priority 2: match $PWD against projects.conf (longest path wins)
if [ -z "$SESSION" ]; then
  BEST_LEN=0
  while IFS='|' read -r name spath _; do
    expanded=$(eval echo "$spath")
    if [[ "$PWD" == "$expanded"* ]]; then
      len=${#expanded}
      if (( len > BEST_LEN )); then
        BEST_LEN=$len
        SESSION="$name"
      fi
    fi
  done < <(grep -v '^\s*#' "${MATRIX_HOME:-$HOME/.matrix}/projects.conf" 2>/dev/null | grep -v '^\s*$')
fi

# Priority 3: tmux session name itself
if [ -z "$SESSION" ] && [ -n "$TMUX_SESSION" ]; then
  SESSION="$TMUX_SESSION"
fi

# Priority 4: folder name
SESSION="${SESSION:-$PROJECT}"

# Suppress notifications from the actual matrix control session (home directory).
# Only when @matrix_project explicitly says "matrix" AND tmux session is "matrix" —
# don't suppress numbered sessions that happen to have PWD=~.
if [[ "$SESSION" == "matrix" && "$TMUX_SESSION" == "matrix" ]]; then
  exit 0
fi

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/}
  printf '%s' "$s"
}

# Post to server — handles SSE toast + web push. tmuxSession lets the server route the
# notification to this exact terminal instead of guessing from the project label.
curl -s -X POST "http://localhost:${MATRIX_PORT:-7778}/api/notify" \
  -H 'Content-Type: application/json' \
  -d "{\"message\":\"$(json_escape "$MSG")\",\"project\":\"$(json_escape "$SESSION")\",\"session\":\"$(json_escape "$SESSION")\",\"tmuxSession\":\"$(json_escape "$TMUX_SESSION")\"}" \
  >/dev/null 2>&1
