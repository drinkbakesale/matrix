#!/bin/sh
# Builds the matrix-rm2 client. Usage: rm2-build host|arm|gateway  (prints the binary path)
# gateway: GOOS=linux GOARCH=<arm64|arm|mipsle|amd64> rm2-build gateway
# Reproducible: Go toolchain only, no module downloads (the module has no dependencies).
# The output is cached by a hash of the client sources, so an unchanged tree is
# never rebuilt (the Go toolchain is not even started).
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
target="${1:-host}"
out="${RM2_BUILD_DIR:-${TMPDIR:-/tmp}/matrix-rm2-build}"
mkdir -p "$out"
case "$target" in
  host) name="matrix-rm2-host" ;;
  arm)  name="matrix-rm2-arm"; GOOS=linux; GOARCH=arm; GOARM=7; export GOOS GOARCH GOARM ;;
  gateway) : "${GOOS:?set GOOS and GOARCH for the gateway, e.g. GOOS=linux GOARCH=arm64}"; name="matrix-rm2-gateway-$GOOS-${GOARCH:?}"; export GOOS GOARCH ;;
  *) echo "rm2-build: unknown target $target" >&2; exit 2 ;;
esac
key="$(cd "$here/rm2" && find . -type f \( -name '*.go' -o -name '*.gz' -o -name go.mod -o -name '*.json' -o -name VERSION \) | LC_ALL=C sort | while IFS= read -r f; do shasum -a 256 "$f"; done | shasum -a 256 | cut -c1-16)"
bin="$out/$name-$key"
if [ -x "$bin" ]; then echo "$bin"; exit 0; fi
command -v go >/dev/null 2>&1 || { echo "rm2-build: the Go toolchain is required (brew install go)" >&2; exit 3; }
export GOFLAGS=-mod=mod GOPROXY=off GOTOOLCHAIN=local CGO_ENABLED=0
export GOCACHE="${GOCACHE:-$out/gocache}"
tmp="$bin.$$.tmp"
(cd "$here/rm2" && go build -trimpath -buildvcs=false -ldflags "-s -w -buildid= -X main.buildVersion=$(cat "$here/rm2/VERSION")" -o "$tmp" ./cmd/matrix-rm2) >&2
mv "$tmp" "$bin"
echo "$bin"
